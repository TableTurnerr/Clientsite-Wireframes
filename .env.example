# ─── Supabase (Cloud) ────────────────────────────────────────────────
# Use the SAME project as the parent site so accounts are shared.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Required for /api/mcp so AI agents can read/write canvas
# content without an end-user session. NEVER expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Unified Auth / Cross-Subdomain SSO ──────────────────────────────
# All vars below are PROD-ONLY. Leave unset in dev so the wireframes
# stay open without auth on localhost.
#
# Cookie domain — must match the parent app's value so both sites read
# the same Supabase auth cookie.
NEXT_PUBLIC_COOKIE_DOMAIN=.tableturnerr.com
# Central auth host. Unauthenticated visitors are bounced here.
NEXT_PUBLIC_AUTH_URL=https://auth.tableturnerr.com
# Parent app URL — used by the "Admin panel" link in the user chip.
NEXT_PUBLIC_APP_URL=https://tableturnerr.com
